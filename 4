# Lagrange Interpolation Method
n = int(input("Enter number of data points: "))
x = []
y = []
print("Enter values of x and y:")
for i in range(n):
    xi = float(input(f"x[{i}] = "))
    yi = float(input(f"y[{i}] = "))
    x.append(xi)
    y.append(yi)
xr = float(input("Enter the value of x to find f(x): "))
yr = 0
for k in range(n):
    Lk = 1
    for i in range(n):
        if i != k:
            Lk *= (xr - x[i]) / (x[k] - x[i])
    yr += y[k] * Lk
print(f"\nInterpolated value at x = {xr} is f(x) = {yr}")
