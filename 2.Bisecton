def f(x):
    return x**3-4*x-9
a=2
b=3
n=9
if f(a)*f(b)>= 0:
    print("Bisection Method Not satisfied,Operation Stopped")
    none,0
else:
    for i in range(n):
        c = (a + b) / 2
        print(f"Iteration {i+1} :c = {c}, f(c)={f(c)}")
        if f(c)==0:
            break
        elif f(a)*f(c)<0:
            b=c
        else:
            a=c
